# LLM API Key — Google Gemini powers chat, embeddings, and summarization
GOOGLE_API_KEY="your-google-api-key"

# PostgreSQL (local Docker container with the pgvector extension)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/email_assistant"

# Redis
REDIS_URL="redis://localhost:6379"

# Dev mode — set to 1 for verbose tool-call logging
DEV_MODE="0"
